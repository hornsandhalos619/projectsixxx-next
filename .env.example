# Copy to .env.local for next dev. Set the same names on Vercel.
# Never commit values.

# --- Auth (Auth.js / NextAuth) ---
AUTH_SECRET=
AUTH_URL=https://projectsixxx.com
AUTH_TRUST_HOST=true

# House credentials are always on (username or email + password).
# Production needs a durable account store: Supabase and/or DATABASE_URL (below).
# Local `next dev` writes gitignored data/house-accounts.json.

# Comma-separated Founder allowlist (case-insensitive). Example: hornsandhalos619@gmail.com
# Founder is seeded only from this list. First signup is a Member.
FOUNDER_EMAILS=

# Optional leftover Google OAuth names. Unused. House login is credentials only.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# X / Twitter OAuth — future follow-up. Not wired in this app yet.
# AUTH_TWITTER_ID=
# AUTH_TWITTER_SECRET=

# Magic-link email is not shipped.
# AUTH_EMAIL_SERVER=
# AUTH_EMAIL_FROM=

# Retired shared-password emergency path. Do not set.
# AUTH_DEMO=
# AUTH_DEMO_PASSWORD=

# --- Live-edit CMS + house accounts (preferred) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Journal CMS fallbacks (first match after Supabase) ---
# Also used as the house-accounts store when Supabase is unset.
# 1) Neon / Vercel Postgres
DATABASE_URL=
POSTGRES_URL=

# 2) Vercel Blob (journal JSON + optional media)
BLOB_READ_WRITE_TOKEN=

# 3) GitHub Contents API writing into content/
GITHUB_TOKEN=
GITHUB_REPO=hornsandhalos619/projectsixxx-next
GITHUB_BRANCH=main

# Optional site settings
HORNS_AND_HALOS_URL=
SHOPIFY_URL=
SPREADSHOP_URL=

# Optional public folder for R001 mp4s (Vercel Blob / CDN). Empty = /ads/r001/
# NEXT_PUBLIC_R001_ADS_BASE=
