# Copy to .env.local for next dev. Set the same names on Vercel.
# Never commit values.

# --- Auth (NextAuth) ---
AUTH_SECRET=
AUTH_URL=https://projectsixxx.com
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=
AUTH_EMAIL_SERVER=
AUTH_EMAIL_FROM=

# Emergency credentials provider. Set AUTH_DEMO=1 only when needed.
AUTH_DEMO=
AUTH_DEMO_PASSWORD=

# Comma-separated Founder allowlist (lowercase). Example: hornsandhalos619@gmail.com
FOUNDER_EMAILS=

# --- Journal CMS (first match wins) ---
# 1) Neon / Vercel Postgres
DATABASE_URL=
POSTGRES_URL=

# 2) Vercel Blob
BLOB_READ_WRITE_TOKEN=

# 3) GitHub Contents API writing into content/
GITHUB_TOKEN=
GITHUB_REPO=hornsandhalos619/projectsixxx-next
GITHUB_BRANCH=main

# Optional site settings
HORNS_AND_HALOS_URL=
SHOPIFY_URL=
SPREADSHOP_URL=
