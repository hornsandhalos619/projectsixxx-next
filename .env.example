# Copy to .env.local for next dev. Set the same names on Vercel.
# Never commit values.

# --- Auth (NextAuth) ---
AUTH_SECRET=
AUTH_URL=https://projectsixxx.com
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=
AUTH_EMAIL_SERVER=
AUTH_EMAIL_FROM=

# Emergency credentials provider. Set AUTH_DEMO=1 only when needed.
# Password stays empty here. Seat the value on Vercel / .env.local only.
AUTH_DEMO=
AUTH_DEMO_PASSWORD=

# Comma-separated Founder allowlist (lowercase). Example: hornsandhalos619@gmail.com
# Login id `6` maps to the first entry when AUTH_DEMO=1.
FOUNDER_EMAILS=

# --- Live-edit CMS (preferred) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Journal CMS fallbacks (first match after Supabase) ---
# 1) Neon / Vercel Postgres
DATABASE_URL=
POSTGRES_URL=

# 2) Vercel Blob (journal JSON + optional media)
BLOB_READ_WRITE_TOKEN=

# 3) GitHub Contents API writing into content/
GITHUB_TOKEN=
GITHUB_REPO=hornsandhalos619/projectsixxx-next
GITHUB_BRANCH=main

# Optional site settings
HORNS_AND_HALOS_URL=
SHOPIFY_URL=
SPREADSHOP_URL=
